  "required_capabilities": [
    "config.get",
    "config.set",
    "context.get",
    "permission.check",
    "storage.delete",
    "storage.get",
    "storage.list",
    "storage.set"
  ],
  "event": {
    "event": "message",
    "payload": {
      "text": "ping",
      "group_id": 123456,
      "user_id": 456789
    }
  },
  "expected_action": {
    "type": "send_group_msg",
    "params": {
      "group_id": 123456,
      "message": "pong"
    }
  },
