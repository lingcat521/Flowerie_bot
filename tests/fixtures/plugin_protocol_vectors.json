    "key": "counter",
    "value": {
      "n": 1
    },
    "bad_key": "../evil"
  },
  "permission": {
    "granted": "send_message",
    "denied": "web_ui"
  },
  "hook": {
    "name": "status",
    "args": [],
    "expected_result": {
      "counter": 1
    }
  },
  "engine_values": {
    "operator_key": "from_engine"
  }
