{
  "id": "minimal_py",
  "name": "Minimal Python Plugin",
  "version": "1.0.0",
  "author": "Flowerie",
  "description": "任务书《插件测试》的最小 Python 插件（与 TS/Go/Rust/Java 最小插件语义完全一致）",
  "runtime": "python",
  "entry": "plugin.py",
  "api_version": "1",
  "permissions": [
    "read_message",
    "send_message",
    "plugin.call.*",
    "plugin.emit",
    "web_ui"
  ],
  "web_ui": {
    "static": "static",
    "entry": "webui_page",
    "pages": [
      { "id": "index", "title": "Index", "render": "plugin" }
    ]
  }
}
