# DeepSeek API
# ===== 对话模型：第三方厂商 或 本机回环模型 =====
# 第三方厂商：填厂商的 chat/completions 地址与密钥（DeepSeek / OpenAI 兼容服务均可）
# 本机回环模型（Ollama / llama.cpp / vLLM / LM Studio 等）：把地址写成 127.0.0.1 或 localhost，
#   密钥可以留空——此时不会发送 Authorization 头，也不需要填假 key。
#   例：DEEPSEEK_API_URL=http://127.0.0.1:11434/v1/chat/completions
#       DEEPSEEK_MODEL=qwen2.5:7b
#       DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=sk-your-key-here          # 必填（本机回环模型可留空）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
# 本机回环模型免密钥开关：true=地址为 127.0.0.1/localhost/::1 时允许密钥留空（默认开）
AI_ALLOW_LOOPBACK_NO_KEY=true

# 引战检测 AI（可选；留空则回退用 DeepSeek 的 key/网址/模型检测引战）
# 可填其他 OpenAI 兼容的内容安全模型
TOXIC_API_KEY=
TOXIC_API_URL=
TOXIC_MODEL=deepseek-flash

# 视觉识图（花璃看图/表情包；可选，留空回退用 DeepSeek key/网址）
VISION_MODEL=deepseek-flash
VISION_API_URL=
VISION_API_KEY=
VISION_TIMEOUT=30
# 是否识别合并转发（聊天记录）里的图片（默认false，省视觉token；想开改true）
VISION_FORWARD_IMAGES=false

# 稳定性
# 单条消息处理超时（秒）：超过视为卡死跳过，防止一条慢消息堵住整个群
EVENT_PROCESS_TIMEOUT=90
# 同时处理消息的并发上限（AI/识图都吃这个额度）
MAX_CONCURRENT_AI=3
# 单次逻辑 AI 操作的最大重试次数（首次尝试+重试；每次尝试都单独过预算闸门）
AI_MAX_RETRIES=3
# 上下文崩溃持久化（SQLite）：周期备份最近50条，意外去世后重启自动恢复
# 旧版 .json 备份文件首次启动会自动迁移到同目录 .db
CONTEXT_BACKUP_PATH=./data/context_backup.db
CONTEXT_BACKUP_INTERVAL=60

# Bot 基础信息
BOT_QQ=114514                               # ⚠️ 必填
BOT_NICKNAME=花璃

# 连接配置
WS_HOST=127.0.0.1
WS_PORT=3001
HTTP_API_BASE=http://127.0.0.1:3000
# 反向 WS 鉴权 token（可选；空=不鉴权，仅建议在 WS_HOST 绑 loopback 时留空）
# 设置后 NapCat 握手需带 Authorization: Bearer <token> 或 ?access_token=<token>
WS_TOKEN=

# 行为策略
ONLY_REPLY_WHEN_AT=false
USER_COOLDOWN=5
BOT_COOLDOWN=2
MAX_REPLY_LENGTH=40
MAX_CONSECUTIVE_REPLIES=3
# 长回复边界切分（Layer A，对齐 dsh-qq-bridge splitText）：默认 false=旧行为
# （超过 MAX_REPLY_LENGTH 截断 + "..."）；true=按「换行→句尾标点→逗号→空格→硬切」
# 切多条独立消息发送，内容零丢失。条数受 SPLIT_REPLY_MAX_MESSAGES 约束。
SPLIT_REPLY_ENABLED=false
# 切分单条段长上限（默认 200：开启切分时模型可写长回复再分段；40=MAX_REPLY_LENGTH 时切分事实休眠）
SPLIT_REPLY_SEGMENT_LIMIT=200
# 切分最大条数（防爆屏；超出条数的尾部段被丢弃）
SPLIT_REPLY_MAX_MESSAGES=8
# 切分/流式段的发送间隔（none=立即发送保流式及时性 / fixed / random）
SPLIT_REPLY_INTERVAL_MODE=none
# 流式分句（Layer B，对齐 dsh-qq-bridge 流式缓冲）：默认 false=整轮完成后单条回复；
# true=边生成边按「句尾标点/换行边界」发送，逐 token 到达不会刷屏。需 Provider 支持 SSE。
STREAM_REPLY_ENABLED=false
# 句子缓冲参数：累积达 MIN_FLUSH 且命中句尾标点/换行才发送；无边界时 MAX_FLUSH 强制发
STREAM_REPLY_MIN_FLUSH=8
STREAM_REPLY_MAX_FLUSH=200
CONTEXT_SIZE=300
LOG_LEVEL=INFO
# 日志格式：text=开发环境人类可读；json=生产环境 JSON lines（含 trace_id/event 字段）
LOG_FORMAT=text

# 随机主动聊天
NIGHT_SILENCE_START=0
NIGHT_SILENCE_END=8
ACTIVE_CHAT_COOLDOWN=180
BOT_CONSECUTIVE_REPLY_COOLDOWN=60

# 主动发言概率（全部可配置；默认值 = 原硬编码，行为零变化）
# —— 上下文随机回复概率（「1%~5%」那套逻辑）——
PROACTIVE_MESSAGE_MIN_PROBABILITY=0.01     # 概率钳制下限（0.0~1.0）
PROACTIVE_MESSAGE_MAX_PROBABILITY=0.05     # 概率钳制上限（0.0~1.0，须 >= 下限）
PROACTIVE_MESSAGE_BASE_PROBABILITY=0.03    # 基础概率
PROACTIVE_MESSAGE_USER_BOOST=0.01          # 最近5条中用户消息>=2时的增量
PROACTIVE_MESSAGE_SINGLE_USER_PROBABILITY=0.02   # 单用户连发时的低概率（防刷屏）
PROACTIVE_MESSAGE_SHORT_MESSAGE_PROBABILITY=0.02 # 最后一条消息<2字时的低概率
PROACTIVE_MESSAGE_EMPTY_CONTEXT_PROBABILITY=0.02 # 群尚无上下文时的回复概率
PROACTIVE_MESSAGE_BOT_MULTIPLIER=0.3       # 机器人连续发言>=2条时的衰减系数（1.0=不衰减）
# —— 主动聊天循环（只配置化数字，不改逻辑）——
ACTIVE_CHAT_PROBABILITY=0.10               # 主动聊天循环触发概率
ACTIVE_CHAT_INTERVAL_MIN_SECONDS=5         # 轮询间隔下限
ACTIVE_CHAT_INTERVAL_MAX_SECONDS=10        # 轮询间隔上限（须 >= 下限）
ACTIVE_CHAT_CONSECUTIVE_COOLDOWN_SECONDS=1800  # 连续主动发言>=2次后的冷却

# 复读
REPEAT_WINDOW=120
REPEAT_THRESHOLD=3

# 引战冷却
TOXIC_WARNING_COOLDOWN=900

# 戳戳回复开关
POKE_REPLY_ENABLED=true

# 记忆库路径（SQLite 数据库文件；旧版 memory.json 首次启动自动迁移到同目录 .db）
MEMORY_PATH=./data/memory.db
# 用户原话记忆保留天数（0=永久保留；>0 时超过天数的记忆自动清理）
MEMORY_TTL_DAYS=0
# AI 推断记忆(model)保留天数（低信任，默认 30 天自动过期；0=跟随 MEMORY_TTL_DAYS）
MODEL_MEMORY_TTL_DAYS=30
# 审计日志路径（记录所有记忆写入/删除）
AUDIT_LOG_PATH=./data/audit.log

# 消息存档（默认关闭，隐私优先；开=true 才会写入存档目录）
ARCHIVE_ENABLED=false
ARCHIVE_BASE_DIR=./data/archive
ARCHIVE_RETENTION_DAYS=0          # 存档保留天数（0=永久；>0 自动清理过期）
ARCHIVE_MAX_SIZE_MB=0             # 每群存档目录大小上限MB（0=不限；超出删最旧）

# ========================================
# 【安全审计加固】
# 资源限制（防止超大文件/超长输入烧 CPU/RAM/Token）
# ========================================
MAX_FILE_TEXT_CHARS=8000        # 文件解析后提取文本的最大字符数
MAX_FILE_DOWNLOAD_BYTES=2097152 # 文件解码字节兜底上限（2MB）
MAX_PDF_PAGES=100               # PDF 最多解析页数
MAX_EXCEL_CELLS=50000           # Excel 最多解析单元格
MAX_CSV_ROWS=10000              # CSV 最多解析行数
MAX_AI_INPUT_CHARS=8000         # 单次 AI 输入（上下文+消息）最大字符数
MAX_IMAGES_PER_MESSAGE=10       # 单条消息最多识图张数
MAX_FORWARD_DEPTH=5             # 嵌套转发最大展开深度
MAX_FORWARD_MESSAGES=100        # 展开后消息总数上限
MAX_FORWARD_NODES=500           # 递归节点总数上限
MAX_FORWARD_FETCHES=20          # 单条消息最多拉取转发次数
DAILY_AI_CALL_BUDGET=1000       # 全局每日 AI 调用上限（默认1000；0=不限）
# AI 熔断（防失败风暴）：Provider 级（全局）+ 群级（有界，防单群故障拖垮其他群）
AI_CIRCUIT_BREAKER_FAILURES=10   # Provider 连续可重试失败次数阈值（超时/网络/429/5xx；4xx 不计）
AI_CIRCUIT_BREAKER_PAUSE_SECONDS=60  # Provider 熔断冷却秒数
GROUP_CIRCUIT_BREAKER_FAILURES=5 # 单群逻辑请求连续失败阈值
GROUP_CIRCUIT_BREAKER_PAUSE_SECONDS=30 # 群级熔断冷却秒数
GROUP_CIRCUIT_BREAKER_MAX_GROUPS=1000  # 群级熔断器容量上限（超出淘汰最旧）
GROUP_CIRCUIT_BREAKER_TTL_SECONDS=604800 # 群级熔断器空闲 TTL（秒，默认 7 天）
GROUP_DAILY_AI_CALL_BUDGET=300   # 每群每日 AI 调用上限（默认300；0=不限）
USER_AI_CALL_MIN_INTERVAL=10    # 同一用户两次 AI 回复最小间隔秒数（默认10）
BUDGET_EXHAUSTED_NOTICE=true    # 额度用尽时在群里说一句提示（每天每群一次）
MAX_IMAGE_DOWNLOAD_BYTES=10485760  # 单张图片下载大小上限（10MB）
IMAGE_DOWNLOAD_MAX_REDIRECTS=3  # 图片下载最大重定向次数
# 可选图片主机白名单（逗号分隔；空=放行所有 http/https，设置后只放行白名单+NapCat 本地 loopback）
IMAGE_ALLOWED_HOSTS=

# ========================================
# 【表情包 Sticker】Vision 索引缓存于 SQLite，重启不重复调 API
# ========================================
STICKER_DIR=
STICKER_ENABLED=false
STICKER_COOLDOWN=60
STICKER_DB_PATH=./data/stickers.db

# ========================================
# 【MCP 外部工具】默认关闭；工具白名单外的工具一律拒绝
# ========================================
MCP_ENABLED=false
MCP_SERVER_URL=
MCP_SERVER_NAME=mcp
MCP_TIMEOUT=15
MCP_MAX_TOOL_CALLS=5
MCP_ALLOWED_TOOLS=
# 插件式多 MCP server（JSON 数组；每个元素：name/url/allowed_tools?/timeout?/enabled?；为空时用上面单 server 字段）
# 例：[{"name":"search","url":"https://mcp.example.com/mcp","allowed_tools":"web_search","timeout":15},
#      {"name":"github","url":"https://mcp.example.com/gh",
#       "auth":{"type":"bearer","token":"<你的 token>"}}]
# auth 可选：{"type":"bearer","token"} / {"type":"api_key","header":"X-API-Key","token"} /
#           {"type":"header","name":"X-Auth","value"} / {"type":"basic","username","password"}
# 不写 auth（或写 null）= 无认证，旧配置无需改动
MCP_SERVERS=
# 显式放行的本地/内网主机白名单（逗号分隔；如自建 MCP server 在 127.0.0.1 或内网时填写）
MCP_ALLOWED_HOSTS=
MCP_CIRCUIT_FAILURES=5
MCP_CIRCUIT_PAUSE_SECONDS=60
# 单 server 认证方式：none / bearer / api_key / header / basic（空 = none）
MCP_AUTH_TYPE=
# 单 server 认证密钥（bearer / api_key；敏感，勿提交）
MCP_AUTH_TOKEN=
# api_key 的 header 名（默认 X-API-Key）或 header 模式的 name
MCP_AUTH_HEADER=
# basic 认证用户名
MCP_AUTH_USERNAME=
# basic 认证密码（敏感，勿提交）
MCP_AUTH_PASSWORD=

# ========================================
# 【Web UI 管理后台】默认开启（只监听本机回环，不对外）；端口不能与 WS_PORT 相同
# ========================================
WEB_UI_ENABLED=true
WEB_UI_HOST=127.0.0.1
# 显式开关：true 时绑定 0.0.0.0（局域网/公网可访问，默认仅本机；开启后启动日志会警告）
WEB_UI_ALLOW_LAN=false
WEB_UI_PORT=8080
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=
WEB_UI_TOKEN_TTL_SECONDS=3600

# ========================================
# 【自定义 Prompt】全局/群聊（/prompt 命令，管理员可改）
# ========================================
MAX_CUSTOM_PROMPT_LENGTH=2000

# ========================================
# 【隐私与数据治理】
# 禁用记忆的群（这些群里花璃不写任何记忆）
MEMORY_DISABLED_GROUPS=
# 管理员 QQ（逗号分隔，可执行 /memory_clear /memory_dump）
ADMIN_QQ_IDS=

# ========================================
# 【群聊白名单控制】
# 留空（= 后面什么都不填）→ 允许所有群 + 主动聊天自动选活跃群
# 填 [群号1, 群号2] → 仅限这些群
# ========================================
ALLOWED_GROUP_IDS=

# ========================================
# 【引战检测控制】
# [] = 不检测任何群
# [群号] = 仅在该群检测
# ========================================
TOXIC_GROUP_IDS=[]
# ========================================
# 【人格系统（Persona）v1.2.0】
# 默认（兜底）人格 id：flowerie（花璃）/ atri（亚托莉 ATRI）/ isla（艾拉）/ 自定义人格 id
# 人格资源存 data/settings.db，Web UI「人格」页管理（全局/群聊/自定义）
# ========================================
PERSONA_DEFAULT=flowerie
# 单个人格 system_prompt 最大长度（字）
MAX_PERSONA_PROMPT_LENGTH=8000
# 自定义人格总数上限（内置不计，防无限增长）
PERSONA_MAX_COUNT=200
# 管理员补充发言规则（每行一条；优先级：安全策略 > 人格 > 人格内置规则 > 本条；
# 只用于指定输出风格，不能覆盖安全策略）。Web UI「人格」页编辑
ADMIN_RESPONSE_RULES=["回复尽量简短", "高兴时可以用感叹号"]

# ========================================
# 【插件系统（Plugin System）v1.2.0】
# 受控插件运行时：目录扫描自动发现（发现 ≠ 自动执行，新插件默认禁用）；
# 安装（上传 ZIP / URL）/ 启用 / 权限批准 / 卸载均在 Web UI「插件」页（管理员操作）
# ========================================
PLUGIN_DIR=./plugins
# 插件保护级别：normal（推荐）/ relaxed / unsafe（仅可信插件，作者概不负责）
# 任何级别都保留：manifest 校验 / 管理员权限 / 进程隔离 / 日志 / 崩溃保护 / 资源限制 / 权限强制
PLUGIN_PROTECTION=normal
# 注册表插件总数上限
PLUGIN_MAX_COUNT=100
# URL 下载插件包大小上限（字节，默认 5MB）
PLUGIN_URL_MAX_BYTES=5242880
# URL 下载超时（秒）
PLUGIN_URL_TIMEOUT=15
# ZIP 解压后总大小上限（字节，默认 50MB，防 Zip Bomb）
PLUGIN_ZIP_MAX_UNZIPPED_BYTES=52428800
# ZIP 包内文件数上限
PLUGIN_ZIP_MAX_FILES=200

# ========================================
# 【NapCat WebSocket】正向/反向二选一（默认 reverse=原有行为：NapCat 连接 Flowerie）
# forward=Flowerie 作为客户端连接 NapCat 的正向 WS server（需配置 NAPCAT_WS_URL）
# ========================================
NAPCAT_WS_MODE=reverse
NAPCAT_WS_URL=
# forward 模式鉴权 token（绝不写入日志；NapCat 侧需配置相同 access token）
NAPCAT_ACCESS_TOKEN=
# forward 鉴权通道（两种约定二选一，**绝不同时发送**）：
#   header（默认）= Authorization: Bearer <token>（URL 不带 token，避免代理/访问日志泄漏）
#   query = URL ?access_token=<urlencoded token>（OneBot11/NapCat 约定；日志已脱敏）
NAPCAT_WS_AUTH_MODE=header

# ========================================
# 【群聊梗/黑话知识层（Meme Knowledge）v1.0.1】
# 每个群完全隔离的梗知识库；按消息命中注入；MEME_LEARNING_ENABLED=true 时
# 每 24 小时批量总结一次群聊（必要时经 MCP 检索验证），Web UI「群聊知识」页管理
# ========================================
MEME_LEARNING_ENABLED=false
MEME_KNOWLEDGE_DB_PATH=./data/knowledge.db
MEME_SUMMARY_INTERVAL_HOURS=24
MAX_GROUP_MEMES=500
MEME_BUFFER_PER_GROUP=1000
MEME_MAX_GROUPS_PER_RUN=20
MEME_MIN_MESSAGES_PER_SUMMARY=10
MEME_MAX_SUMMARY_CANDIDATES=20

# ========================================
# 【每日群聊摘要（Daily Digest）v2.8.0】
# 每天凌晨把当天对话压缩成滚动摘要（嵌套合并，长期挂机不重启）；默认关
# ========================================
DIGEST_ENABLED=false
DIGEST_DB_PATH=./data/digest.db
DIGEST_AT_HOUR=0              # 本地时区触发时刻（0 = 00:00）
DIGEST_AT_MINUTE=0
DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_MIN_MESSAGES=10        # 安静群自动跳过
DIGEST_MAX_CHARS=400000       # 单群喂给摘要的字符上限（1M 上下文，全量喂）
DIGEST_BUFFER_PER_GROUP=12000 # 每群消息缓冲上限（需重启）
DIGEST_MAX_GROUPS_PER_RUN=20  # 单轮最多处理群数（防爆额度）
DIGEST_EXPORT_DIR=./data/digests   # 摘要 txt 导出目录（留空=只存库不导出）
DIGEST_SOURCE=buffer          # 摘要数据源：buffer=内存缓冲 / archive=隐私存档 txt（需开存档；无料自动回落 buffer）

# ========================================
# 【群友画像（Member Profile）v2.9.0】
# 性格/喜好/个人生活/特点的长期记忆：每日摘要后自动提炼，注入本群活跃成员画像
# ========================================
PROFILE_ENABLED=false
PROFILE_DB_PATH=./data/profiles.db   # 画像持久化库（按群×用户隔离）
PROFILE_MAX_TOKENS=2048              # 画像提取输出上限
PROFILE_MAX_MEMBERS=8                # 注入对话的活跃成员画像上限
PROFILE_SECTION_TTL_DAYS=30          # 单字段多少天没更新就淘汰（0=永久保留）

# ---------- 群管理控制台 / QQ空间（v2.10） ----------
ADMIN_CONSOLE_ENABLED=true           # 群管理控制台开关（Web UI「群管理」页；关=页面提示不可用）
ADMIN_COMMANDS_ENABLED=true          # 群内管理指令开关（/mute /unmute /admin；关=群内指令不响应）
ADMIN_ROLE_CACHE_SECONDS=60          # Bot/成员角色查询缓存秒数（0=不缓存）

# ---------- AI 内置工具层（默认全关；Web UI「自动化」页统一管理） ----------
AI_QZONE_ENABLED=false               # AI 可自主发表/删除 QQ空间说说
AI_QZONE_MAX_PER_DAY=1               # AI 每天最多发几条说说（0=不限）
AI_QZONE_AUTO_ENABLED=false          # AI 定时自己发说说（像真人一样偶尔发动态）
AI_QZONE_AUTO_INTERVAL_HOURS=24      # 自主发动态间隔（小时）
AI_ADMIN_ENABLED=false               # AI 可自主禁言/解禁（仍要求发起人是群主/管理员）
AI_MEMORY_ENABLED=false              # AI 可主动读取当前用户的群记忆
AI_SEARCH_ENABLED=false              # AI 搜索工具（web_search / web_fetch）
AI_GROUP_INFO_ENABLED=false          # AI 查群成员名单（group_members）
AI_PROFILES_ENABLED=false            # AI 读群友画像（member_profile）
AI_KNOWLEDGE_ENABLED=false           # AI 检索群知识/梗（group_knowledge）
AI_POKE_ENABLED=false                # AI 戳一戳（poke；不戳管理员/自己）
AI_TOOL_PROMPT=true                 # 给模型注入工具使用说明（关=只靠工具 schema）
QZONE_IMAGE_DIR=./data/qzone_images  # 配图池目录（AI 从这里挑图）
QZONE_IMAGE_INDEX_PATH=./data/qzone_image_index.json  # 识图描述缓存
QZONE_IMAGE_MAX=50                   # 图片池上限（最新 N 张）
QZONE_IMAGE_DESCRIBE_LIMIT=12        # 单次列图最多识图几张
QZONE_ENABLED=true                   # QQ空间功能开关（Web UI「QQ空间」页）
QZONE_DEFAULT_UGC_RIGHT=1            # 默认查看权限：1 所有人 / 4 好友 / 16 部分好友 / 64 仅自己 / 128 部分好友不可见
QZONE_HISTORY_PATH=./data/qzone_history.json  # 本机发布历史（tid/摘要/权限/时间）
QZONE_MAX_HISTORY=100                # 发布历史最大条数

# ---------- 私聊（v2.14.0；默认关） ----------
PRIVATE_CHAT_ENABLED=false            # 私聊总开关
PRIVATE_CHAT_ALLOWED_QQS=             # 允许私聊的 QQ（逗号分隔；留空=只允许 ADMIN_QQ_IDS）
PRIVATE_CHAT_ALLOW_STRANGERS=false    # 是否允许临时会话/陌生人
PRIVATE_CHAT_COOLDOWN_SECONDS=3       # 同一人冷却（秒）
PRIVATE_CHAT_CONTEXT_SIZE=40          # 注入的历史条数
PRIVATE_CHAT_MEMORY_ENABLED=true      # 私聊记忆（独立隔离）

# ---------- 网页搜索（v2.15.0；免 key 引擎，默认关） ----------
AI_SEARCH_ENABLED=false               # AI 搜索工具开关（模型自主调用 web_search/web_fetch）
SEARCH_ENGINES=ddg,bing,searxng,ddg-lite  # 启用引擎与回退顺序
SEARCH_MAX_RESULTS=5                  # 默认结果条数（1-10）
SEARCH_TIMEOUT=10                     # 单引擎请求超时（秒）
SEARCH_CACHE_TTL=5                    # 结果缓存分钟数（0=禁用，最大 5）
SEARCH_SAFE_SEARCH=off                # 安全搜索：off/moderate/strict（Bing/DDG 生效）
SEARCH_BLOCKED_DOMAINS=               # 结果域名黑名单（逗号分隔）
SEARCH_SEARXNG_INSTANCES=             # SearXNG 公共实例（留空=内置 6 个）
SEARCH_FETCH_MAX_CHARS=2000           # web_fetch 正文截断字数
SEARCH_PROOF_REQUIRED=true            # 结果附来源 URL 要求
