# Flowerie .env 完整配置模板（首次启动自动生成；编辑后重启生效）
# 分组与说明与 Web UI 配置页同源（config_schema.SCHEMA），不会漂移
# ⚠️ 必填项当前为占位值，请替换为真实值后再启动
# Web UI 保存的配置会写回本文件（原子更新，保留注释与原有变量）

# ========== 基础配置 ==========
# 机器人 QQ 号（需重启）
BOT_QQ=10001  # ⚠️ 必填 · 需重启
# 协议端：onebot（NapCat 等）/ milky（Milky 协议端）
QQ_PROTOCOL=onebot  # 需重启
# 出站段收敛的客户端档案：空 / go-cqhttp / napcat / llbot / onebot11:<client> / milky:<client>
CLIENT_PROFILE=
# Milky 协议端 HTTP 根（/api/<action>）
MILKY_API_BASE=http://127.0.0.1:8080  # 需重启
# Milky 事件推送 WebSocket（/event）
MILKY_EVENT_URL=ws://127.0.0.1:8080/event  # 需重启
# Milky Bearer 鉴权 token
MILKY_ACCESS_TOKEN=  # 需重启
# 机器人昵称（群特色昵称未配置时使用；Web UI 可逐群覆盖）
BOT_NICKNAME=花璃
# 群专属发言规则存储路径（需重启）
GROUP_STYLE_RULES_PATH=./data/style_rules.json  # 需重启
# 群特色昵称存储路径
GROUP_NICKNAMES_PATH=./data/nicknames.json  # 需重启
# 发送通道：auto（WS 优先→HTTP 回退）/ true（仅 WS）/ false（仅 HTTP）
SEND_VIA_WS=auto
# 仅回复 @ 消息（哑巴模式）
ONLY_REPLY_WHEN_AT=false
# 最大回复长度
MAX_REPLY_LENGTH=40
# 连续回复上限
MAX_CONSECUTIVE_REPLIES=3
# 自定义 Prompt 最大长度（需重启）
MAX_CUSTOM_PROMPT_LENGTH=2000  # 需重启

# ========== QQ / OneBot 连接 ==========
# 反向 WS 监听地址（需重启）
WS_HOST=127.0.0.1  # 需重启
# 反向 WS 端口（需重启）
WS_PORT=3001  # 需重启
# NapCat HTTP API 地址（需重启）
HTTP_API_BASE=http://127.0.0.1:3000  # 需重启
# 反向 WS 鉴权 token（留空=不鉴权，需重启）
WS_TOKEN=  # 密钥 · 需重启
# NapCat WS 模式（reverse=Flowerie 做服务端 / forward=连接正向 WS，需重启）
NAPCAT_WS_MODE=reverse  # 需重启
# forward 模式的连接地址（ws:// 或 wss://，需重启）
NAPCAT_WS_URL=  # 需重启
# forward 模式鉴权 token（绝不写日志，需重启）
NAPCAT_ACCESS_TOKEN=  # 密钥 · 需重启
# forward 鉴权通道：header=Bearer 头（默认，URL 不带 token）/ query=URL access_token 参数（OneBot11 约定）；两者绝不同时发送
NAPCAT_WS_AUTH_MODE=header  # 需重启

# ========== AI / Provider 配置 ==========
# AI 回复总开关（关=不请求 Provider，普通功能不受影响）
AI_ENABLED=true
# 分句发送：短回复（<40字）按空格与标点拆成多条独立消息；默认开
SPLIT_REPLY_ENABLED=true
# 低于此长度才拆分（默认 40）
SPLIT_REPLY_LOWER=40
# 高于此长度不拆分，整条发送（默认 100）
SPLIT_REPLY_DISABLE_AT=100
# 单次分句回复最多条数（默认 3）；超出部分缓存，隔 4~6s 发送
SPLIT_REPLY_MAX_MESSAGES=3
# AI 输出 token 上限 max_tokens（默认 200）
DEEPSEEK_MAX_TOKENS=200
# 对话模型 API 密钥（接本机回环模型时可留空：把地址指向 127.0.0.1/localhost）
DEEPSEEK_API_KEY=sk-your-key-here  # ⚠️ 必填 · 密钥
# 对话模型 API 地址（第三方厂商填其 chat/completions；本机模型填 http://127.0.0.1:<端口>/v1/chat/completions，如 Ollama 的 11434）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# 群聊对话模型名（以服务端 /v1/models 列为准）
DEEPSEEK_MODEL=deepseek-flash
# 本机回环模型免密钥：地址为 127.0.0.1/localhost/::1 时允许 API 密钥留空
AI_ALLOW_LOOPBACK_NO_KEY=true
# 引战检测 AI 密钥（留空回退 DeepSeek）
TOXIC_API_KEY=  # 密钥
# 引战检测 AI 地址（留空回退 DeepSeek）
TOXIC_API_URL=
# 引战检测模型（留空回退 DeepSeek）
TOXIC_MODEL=deepseek-flash
# 视觉识图密钥（留空回退 DeepSeek）
VISION_API_KEY=  # 密钥
# 视觉识图 API 地址（留空回退 DeepSeek）
VISION_API_URL=
# 视觉识图模型
VISION_MODEL=deepseek-flash
# 识图超时（秒）
VISION_TIMEOUT=30
# 图片识图总开关（关闭后不描述群图/转发图）
VISION_ENABLED=true
# 识别合并转发里的图片（省视觉 token，默认关）
VISION_FORWARD_IMAGES=false
# 识图路由：auto=主模型支持时直看/不支持走外部；external=永远外部识图；native=强制主模型直看
VISION_ROUTE_MODE=auto
# 主模型原生识图白名单（逗号分隔；auto 模式据此判断主聊天模型是否支持识图）
NATIVE_VISION_MODELS=Agents-A1,Sage-A1.5
# 纯图片消息触发 AI 回复（默认关=只识图记上下文不回，防刷屏）
VISION_REPLY_ON_IMAGE=false
# 主模型直接看图时的预算预算大，独立预算：默认4000）
VISION_CHAT_MAX_TOKENS=8000
# 接话频率：被@时按此概率回复（0~1，默认0.35；1.0=句句都回）
REPLY_PROBABILITY=0.35
# @门控（仅官方桥接部署开：桥接器恒注入@，需配合 REPLY_PROBABILITY 限频；NapCat 保持关=@必回）
MENTION_REPLY_GATE_ENABLED=false

# ========== 行为与回复 ==========
# 上下文条数
CONTEXT_SIZE=300
# 用户冷却（秒）
USER_COOLDOWN=5
# 机器人冷却（秒）
BOT_COOLDOWN=2

# ========== 主动聊天 ==========
# 主动聊天总开关
PROACTIVE_CHAT_ENABLED=true
# 夜间静默开始（小时 0-23）
NIGHT_SILENCE_START=0
# 夜间静默结束（小时 1-24）
NIGHT_SILENCE_END=8
# 主动聊天冷却（秒）
ACTIVE_CHAT_COOLDOWN=180
# 连续回复后冷却（秒）
BOT_CONSECUTIVE_REPLY_COOLDOWN=60
# 主动发言概率下限（0.0~1.0，如 0.01=1%）
PROACTIVE_MESSAGE_MIN_PROBABILITY=0.01
# 主动发言概率上限（0.0~1.0，如 0.05=5%；须 >= 下限）
PROACTIVE_MESSAGE_MAX_PROBABILITY=0.05
# 主动发言基础概率（0.0~1.0，如 0.03=3%）
PROACTIVE_MESSAGE_BASE_PROBABILITY=0.03
# 连续用户消息 >=2 条时的概率增量（0.0~1.0，如 0.01=+1%）
PROACTIVE_MESSAGE_USER_BOOST=0.01
# 单用户连发时的低概率（0.0~1.0，防刷屏）
PROACTIVE_MESSAGE_SINGLE_USER_PROBABILITY=0.02
# 最后一条消息过短（<2 字）时的低概率（0.0~1.0）
PROACTIVE_MESSAGE_SHORT_MESSAGE_PROBABILITY=0.02
# 群尚无上下文时的回复概率（0.0~1.0）
PROACTIVE_MESSAGE_EMPTY_CONTEXT_PROBABILITY=0.02
# 机器人连续发言 >=2 条时的概率衰减系数（0.0~1.0，1.0=不衰减）
PROACTIVE_MESSAGE_BOT_MULTIPLIER=0.3
# 主动聊天循环触发概率（0.0~1.0，如 0.10=10%）
ACTIVE_CHAT_PROBABILITY=0.1
# 主动聊天循环最小轮询间隔（秒）
ACTIVE_CHAT_INTERVAL_MIN_SECONDS=5
# 主动聊天循环最大轮询间隔（秒；须 >= 最小间隔）
ACTIVE_CHAT_INTERVAL_MAX_SECONDS=10
# 连续主动发言 >=2 次后的冷却（秒）
ACTIVE_CHAT_CONSECUTIVE_COOLDOWN_SECONDS=1800

# ========== 复读与防刷 ==========
# 复读检测开关
REPEAT_ENABLED=true
# 防刷/冷却逻辑开关
ANTI_SPAM_ENABLED=true
# 复读检测窗口（秒）
REPEAT_WINDOW=120
# 复读触发次数
REPEAT_THRESHOLD=3
# 引战警告冷却（秒）
TOXIC_WARNING_COOLDOWN=900

# ========== 戳戳 ==========
# 戳戳回复开关
POKE_REPLY_ENABLED=true
# 戳戳回复语（每行一条）
POKE_REPLIES=["戳人家干嘛...", "别戳了...！", "唔...别戳啦", "（缩脑袋）", "好痒...别闹", "好啦好啦 让你戳", "唔 真拿你没办法", "（哈气）", "干什么...！", "呀...！", "再戳我就不理你了哦", "（躲开）", "你手不累嘛", "戳一下就够了哦", "（揉揉被戳的地方）", "哼 再戳就生气了", "（缩头）", "你完蛋了 我记仇了", "戳回去！", "反弹！", "（反手戳你）", "你的手指不要啦？", "再戳就收费了喔", "（假装躲闪）", "（叹气）", "杂鱼 不准戳我", "（摊手）", "你是不是无聊了", "找我玩嘛", "（歪头）", "嘤？", "（茫然）", "？", "哈！！！"]

# ========== 表情包 ==========
# 表情包功能开关
STICKER_ENABLED=false
# 表情包目录（需重启；空=禁用）
STICKER_DIR=  # 需重启
# 主模型原生识图时内联候选图张数（其余只给描述；默认 4）
STICKER_NATIVE_MAX_IMAGES=4
# 被@/叫名字回复后附带随机表情包概率（0~1，默认 0.10）
STICKER_REPLY_PROBABILITY=0.1
# 允许模型用 [STICKER:文件名] 标记选表情包（与分句开关解耦；标记始终剥离不外发）
STICKER_MARKER_ENABLED=true
# 扫描时新索引上限（native 识图每张花模型调用；0=不限，默认 30）
STICKER_INDEX_LIMIT=30
# 表情包索引发并发数（默认 4；0=不限）
STICKER_INDEX_WORKERS=4
# 表情包索引库路径（需重启）
STICKER_DB_PATH=./data/stickers.db  # 需重启
# 表情包冷却（秒）
STICKER_COOLDOWN=60
# 提供给模型的表情包描述上限
STICKER_MAX_LIST=30

# ========== 私聊 ==========
# 私聊总开关（关=私聊消息一律不理；默认关）
PRIVATE_CHAT_ENABLED=false
# 允许私聊的 QQ（留空=只允许 ADMIN_QQ_IDS）
PRIVATE_CHAT_ALLOWED_QQS=
# 是否允许临时会话/陌生人私聊
PRIVATE_CHAT_ALLOW_STRANGERS=false
# 同一人私聊冷却（秒）
PRIVATE_CHAT_COOLDOWN_SECONDS=3
# 私聊注入的历史条数
PRIVATE_CHAT_CONTEXT_SIZE=40
# 私聊记忆写入/读取（按 QQ 号独立隔离）
PRIVATE_CHAT_MEMORY_ENABLED=true

# ========== 文件解析 ==========
# 文件解析总开关（群文件、试解析和 API）
FILE_PARSE_ENABLED=true
# 自动解析群上传文件，并将提取文本纳入后续对话
FILE_PARSE_GROUP_UPLOAD_ENABLED=true
# 启用的文件格式（.env 中用逗号分隔，留空关闭全部）
FILE_PARSE_FORMATS=txt,pdf,docx,xlsx,csv
# 将其他扩展名按 UTF-8 文本尝试（需启用 txt）
FILE_PARSE_TEXT_FALLBACK=true
# 文件解析提取文本上限（字符）
MAX_FILE_TEXT_CHARS=8000
# 文件下载解码字节上限
MAX_FILE_DOWNLOAD_BYTES=2097152
# PDF 最多解析页数
MAX_PDF_PAGES=100
# Excel 最多解析单元格数
MAX_EXCEL_CELLS=50000
# CSV 最多解析行数
MAX_CSV_ROWS=10000

# ========== 识图与图片限制 ==========
# 单条消息最多识图张数
MAX_IMAGES_PER_MESSAGE=10
# 单张图片下载上限（字节）
MAX_IMAGE_DOWNLOAD_BYTES=10485760
# 图片下载最大重定向次数
IMAGE_DOWNLOAD_MAX_REDIRECTS=3
# 图片主机白名单（逗号分隔，空=放行所有）
IMAGE_ALLOWED_HOSTS=

# ========== 合并转发 ==========
# 转发最大展开深度
MAX_FORWARD_DEPTH=5
# 转发展开消息总数上限
MAX_FORWARD_MESSAGES=100
# 转发遍历节点总数上限
MAX_FORWARD_NODES=500
# 单条消息转发拉取次数上限
MAX_FORWARD_FETCHES=20

# ========== MCP 工具 ==========
# MCP 工具开关
MCP_ENABLED=false
# MCP server 地址（单 server）
MCP_SERVER_URL=
# MCP server 名称（需重启）
MCP_SERVER_NAME=mcp  # 需重启
# MCP 多 server JSON 数组（需重启）
MCP_SERVERS=  # 需重启
# 工具调用超时（秒）
MCP_TIMEOUT=15
# 单轮工具调用上限
MCP_MAX_TOOL_CALLS=5
# 工具 allowlist（逗号分隔）
MCP_ALLOWED_TOOLS=
# MCP 本地/内网主机白名单（需重启）
MCP_ALLOWED_HOSTS=  # 需重启
# MCP 熔断失败阈值
MCP_CIRCUIT_FAILURES=5
# MCP 熔断冷却（秒）
MCP_CIRCUIT_PAUSE_SECONDS=60
# 单 server 认证方式：none / bearer / api_key / header / basic（空=none）
MCP_AUTH_TYPE=
# 单 server 认证密钥（bearer / api_key）
MCP_AUTH_TOKEN=  # 密钥
# api_key 的 header 名（默认 X-API-Key）或 header 模式的 name
MCP_AUTH_HEADER=
# basic 认证用户名
MCP_AUTH_USERNAME=
# basic 认证密码
MCP_AUTH_PASSWORD=  # 密钥

# ========== 网页搜索 ==========
# 启用引擎与回退顺序（逗号分隔：ddg,bing,searxng,ddg-lite）
SEARCH_ENGINES=ddg,bing,searxng,ddg-lite
# 默认结果条数（1-10）
SEARCH_MAX_RESULTS=5
# 单引擎请求超时（秒；10-30）
SEARCH_TIMEOUT=10
# 结果缓存分钟数（0=禁用，最大 5）
SEARCH_CACHE_TTL=5
# 安全搜索：off / moderate / strict（Bing/DDG 生效）
SEARCH_SAFE_SEARCH=off
# 结果域名黑名单（逗号分隔；命中域名的条目直接丢弃）
SEARCH_BLOCKED_DOMAINS=[]
# SearXNG 公共实例列表（逗号或换行分隔；留空=内置 6 个）
SEARCH_SEARXNG_INSTANCES=[]
# web_fetch 正文截断字数（1000-8000）
SEARCH_FETCH_MAX_CHARS=2000
# 结果附来源 URL 要求（开=模型必须引用来源；关=仅提示）
SEARCH_PROOF_REQUIRED=true

# ========== 上下文 ==========
# 每日凌晨群聊摘要（默认关=旧路径零变化；开=00:00 把当天对话压缩成滚动摘要）
DIGEST_ENABLED=false
# 摘要持久化库路径（checkpoint / last_date；需重启）
DIGEST_DB_PATH=./data/digest.db  # 需重启
# 摘要触发小时（本地时区，0=00:00）
DIGEST_AT_HOUR=0
# 摘要触发分钟
DIGEST_AT_MINUTE=0
# 摘要时区（zoneinfo 名，如 Asia/Shanghai）
DIGEST_TIMEZONE=Asia/Shanghai
# 缓冲不足该条数的安静群跳过
DIGEST_MIN_MESSAGES=10
# 单群喂给摘要的字符上限
DIGEST_MAX_CHARS=400000
# 每群消息缓冲上限（需重启）
DIGEST_BUFFER_PER_GROUP=12000  # 需重启
# 单轮最多处理群数（防爆额度）
DIGEST_MAX_GROUPS_PER_RUN=20
# 摘要数据源：buffer=内存缓冲（默认）/ archive=隐私存档 txt（需开 ARCHIVE_ENABLED；archive 无料时自动回落 buffer）
DIGEST_SOURCE=buffer
# 摘要 txt 导出目录（人读副本；留空=只存 SQLite 不导出）
DIGEST_EXPORT_DIR=./data/digests
# 群友画像（每日摘要后提炼群友性格/喜好/个人生活/特点并注入对话；默认关）
PROFILE_ENABLED=false
# 画像持久化库路径（需重启）
PROFILE_DB_PATH=./data/profiles.db  # 需重启
# 画像提取输出上限（token）
PROFILE_MAX_TOKENS=2048
# 注入对话的活跃成员画像上限
PROFILE_MAX_MEMBERS=8
# 画像字段多少天没更新就淘汰（0=永久保留）
PROFILE_SECTION_TTL_DAYS=30

# ========== 记忆库 ==========
# 长期记忆总开关（关=不读/写；短期 Context 不受影响）
MEMORY_ENABLED=true
# 记忆库路径（需重启）
MEMORY_PATH=./data/memory.db  # 需重启
# 用户原话记忆保留天数（0=永久）
MEMORY_TTL_DAYS=0
# AI 推断记忆保留天数（0=跟随）
MODEL_MEMORY_TTL_DAYS=30
# 审计日志路径（需重启）
AUDIT_LOG_PATH=./data/audit.log  # 需重启
# 审计日志轮转上限（MB）；0=不轮转（默认）
AUDIT_LOG_MAX_MB=0
# 禁用记忆的群号（逗号分隔）
MEMORY_DISABLED_GROUPS=

# ========== 花语记忆（默认关闭） ==========
# 向量模型（Embedding）
BLOSSOM_MEMORY_EMBEDDING_ENABLED=false
# 重排序模型（Reranker）
BLOSSOM_MEMORY_RERANKER_ENABLED=false
# 自动提取记忆
BLOSSOM_MEMORY_EXTRACT_ENABLED=false
# 长期记忆检索
BLOSSOM_MEMORY_RETRIEVAL_ENABLED=false
# 向量模型名（如 text-embedding-3-small）
BLOSSOM_MEMORY_EMBEDDING_MODEL=
# 向量模型 API 地址
BLOSSOM_MEMORY_EMBEDDING_API_URL=
# 向量模型 API 密钥
BLOSSOM_MEMORY_EMBEDDING_API_KEY=  # 密钥
# 重排序模型名
BLOSSOM_MEMORY_RERANKER_MODEL=
# 重排序 API 地址
BLOSSOM_MEMORY_RERANKER_API_URL=
# 重排序 API 密钥
BLOSSOM_MEMORY_RERANKER_API_KEY=  # 密钥
# 向量维度
BLOSSOM_MEMORY_VECTOR_DIMENSION=1024
# 检索 Top K
BLOSSOM_MEMORY_RETRIEVAL_TOP_K=5
# 重排 Top K
BLOSSOM_MEMORY_RERANK_TOP_K=3
# 相似度阈值
BLOSSOM_MEMORY_SIMILARITY_THRESHOLD=0.6
# 每组记忆上限
BLOSSOM_MEMORY_MAX_ENTRIES=2000
# 记忆 TTL（天，0=永久）
BLOSSOM_MEMORY_TTL_DAYS=90
# 每日提取上限
BLOSSOM_MEMORY_DAILY_EXTRACT_LIMIT=20
# 高级记忆（LivingMemory），默认 OFF
BLOSSOM_MEMORY_ENABLED=false

# ========== 消息存档 ==========
# 消息存档开关（默认关）
ARCHIVE_ENABLED=false
# 存档目录（需重启）
ARCHIVE_BASE_DIR=./data/archive  # 需重启
# 存档保留天数（0=永久）
ARCHIVE_RETENTION_DAYS=0
# 每群存档大小上限 MB（0=不限）
ARCHIVE_MAX_SIZE_MB=0

# ========== 数据路径 ==========
# 存储后端（sqlite=默认；postgres=可选）
STORAGE_BACKEND=sqlite
# PostgreSQL 连接串（postgres 后端必填）
DATABASE_URL=  # 密钥
# 设置库路径（需重启，谨慎修改）
SETTINGS_DB_PATH=./data/settings.db  # 需重启

# ========== 白名单与隐私 ==========
# 允许群号白名单（逗号分隔，空=所有群）
ALLOWED_GROUP_IDS=
# 引战检测群号（逗号分隔，空=不检测）
TOXIC_GROUP_IDS=
# 管理员 QQ（逗号分隔）
ADMIN_QQ_IDS=

# ========== 群管理控制台 ==========
# 群管理控制台开关（关=「群管理」页提示不可用；SDK 直接调用不受限）
ADMIN_CONSOLE_ENABLED=true
# 群内管理指令开关（/mute /unmute /admin；关=群内指令不响应，面板与 SDK 不受影响）
ADMIN_COMMANDS_ENABLED=true
# Bot/成员角色查询缓存秒数（0=不缓存，每次都问平台；默认 60）
ADMIN_ROLE_CACHE_SECONDS=60

# ========== 预算与限额 ==========
# 全局每日 AI 调用上限（0=不限）
DAILY_AI_CALL_BUDGET=1000
# 每群每日 AI 调用上限（0=不限）
GROUP_DAILY_AI_CALL_BUDGET=300
# 同一用户 AI 调用最小间隔（秒）
USER_AI_CALL_MIN_INTERVAL=10
# 额度用尽时在群里说一句提示
BUDGET_EXHAUSTED_NOTICE=true

# ========== 稳定性与熔断 ==========
# 单条消息处理超时（秒）
EVENT_PROCESS_TIMEOUT=90
# 并发 AI 上限（需重启）
MAX_CONCURRENT_AI=3  # 需重启
# AI 最大重试次数
AI_MAX_RETRIES=3
# AI 熔断失败阈值
AI_CIRCUIT_BREAKER_FAILURES=10
# AI 熔断冷却（秒）
AI_CIRCUIT_BREAKER_PAUSE_SECONDS=60
# 群级熔断失败阈值
GROUP_CIRCUIT_BREAKER_FAILURES=5
# 群级熔断冷却（秒）
GROUP_CIRCUIT_BREAKER_PAUSE_SECONDS=30
# 群级熔断器容量上限（需重启）
GROUP_CIRCUIT_BREAKER_MAX_GROUPS=1000  # 需重启
# 群级熔断器空闲 TTL（秒）
GROUP_CIRCUIT_BREAKER_TTL_SECONDS=604800
# 上下文备份库路径（需重启）
CONTEXT_BACKUP_PATH=./data/context_backup.db  # 需重启
# 上下文备份间隔（秒）
CONTEXT_BACKUP_INTERVAL=60

# ========== 安全与资源限制 ==========
# 单次 AI 输入最大字符数
MAX_AI_INPUT_CHARS=8000

# ========== 日志 ==========
# 日志级别（需重启）
LOG_LEVEL=INFO  # 需重启
# 日志格式 text/json（需重启）
LOG_FORMAT=text  # 需重启

# ========== Web UI ==========
# Web UI 开关（需重启）
WEB_UI_ENABLED=true  # 需重启
# Web UI 监听地址（需重启）
WEB_UI_HOST=127.0.0.1  # 需重启
# 绑定 0.0.0.0 局域网可访问（需重启）
WEB_UI_ALLOW_LAN=false  # 需重启
# Web UI 端口（需重启）
WEB_UI_PORT=8080  # 需重启
# 登录 token 有效期（秒）
WEB_UI_TOKEN_TTL_SECONDS=3600

# ========== 自动化 ==========
# AI 可自主发表/删除 QQ空间说说（每日额度见 AI_QZONE_MAX_PER_DAY）
AI_QZONE_ENABLED=false
# AI 每天最多发几条说说（0=不限）
AI_QZONE_MAX_PER_DAY=1
# AI 自主调用工具搜索/发送表情包（需 STICKER_ENABLED 开启；受群级冷却约束）
AI_STICKER_ENABLED=false
# AI 定时自己发说说（结合配图池与识图描述，像真人一样偶尔发动态）
AI_QZONE_AUTO_ENABLED=false
# 自主发动态间隔（小时，最小 1）
AI_QZONE_AUTO_INTERVAL_HOURS=24
# AI 可自主禁言/解禁（仍要求发起人是群主/管理员，且 Bot 有管理权限）
AI_ADMIN_ENABLED=false
# AI 可主动读取当前用户的群记忆（memory_recall）
AI_MEMORY_ENABLED=false
# 给模型注入工具使用说明（群管/空间/记忆的调用时机与红线；关=只靠工具 schema）
AI_TOOL_PROMPT=true
# 配图池目录（AI 从这里挑图；需重启）
QZONE_IMAGE_DIR=./data/qzone_images  # 需重启
# 识图描述缓存路径（需重启）
QZONE_IMAGE_INDEX_PATH=./data/qzone_image_index.json  # 需重启
# 图片池上限（按修改时间取最新 N 张）
QZONE_IMAGE_MAX=50
# 单次列图时最多识图几张（防一次调用打爆视觉额度）
QZONE_IMAGE_DESCRIBE_LIMIT=12
# QQ空间功能开关（关=「QQ空间」页提示不可用）
QZONE_ENABLED=true
# 默认查看权限：1 所有人 / 4 好友 / 16 部分好友 / 64 仅自己 / 128 部分好友不可见
QZONE_DEFAULT_UGC_RIGHT=1
# 本机发布历史路径（需重启；含 tid 与摘要，用于面板删除）
QZONE_HISTORY_PATH=./data/qzone_history.json  # 需重启
# 发布历史最大条数（超出淘汰最旧）
QZONE_MAX_HISTORY=100
# AI 搜索工具开关（默认关；模型自主调用 web_search/web_fetch）
AI_SEARCH_ENABLED=false
# AI 群信息开关（默认关；模型可查群成员名单/单人画像）
AI_GROUP_INFO_ENABLED=false
# AI 群友画像开关（默认关；上面的群信息里是否含画像读取）
AI_PROFILES_ENABLED=false
# AI 群知识开关（默认关；模型可检索本群知识/梗）
AI_KNOWLEDGE_ENABLED=false
# AI 戳一戳开关（默认关；互动玩笑，目标限制：非管理员/非自己）
AI_POKE_ENABLED=false

# ========== 人格（Persona） ==========
# 默认人格 id（兜底，立即生效）
PERSONA_DEFAULT=flowerie
# 人格 system_prompt 最大长度（需重启）
MAX_PERSONA_PROMPT_LENGTH=8000  # 需重启
# 自定义人格总数上限（内置不计）
PERSONA_MAX_COUNT=200
# 管理员补充发言规则（每行一条；优先级：安全策略 > 人格 > 人格内置规则 > 本条）
ADMIN_RESPONSE_RULES=["回复尽量在15～20字以内 简洁自然 严禁话唠", "用空格代替逗号 不可以使用句号 问号 感叹号等标点符号", "绝对不使用任何 emoji 表情", "短句为主 极少用感叹号和波浪号表达语气 不可过度使用"]

# ========== 插件系统 ==========
# 插件目录（需重启；自动发现其中的 */manifest.json）
PLUGIN_DIR=./plugins  # 需重启
# 插件保护级别（normal/relaxed/unsafe；unsafe 风险自负）
PLUGIN_PROTECTION=normal
# 注册表插件总数上限（需重启）
PLUGIN_MAX_COUNT=100  # 需重启
# URL 下载插件包大小上限（字节）
PLUGIN_URL_MAX_BYTES=5242880
# URL 下载超时（秒）
PLUGIN_URL_TIMEOUT=15
# 解压后总大小上限（字节，防 Zip Bomb）
PLUGIN_ZIP_MAX_UNZIPPED_BYTES=52428800
# 包内文件数上限
PLUGIN_ZIP_MAX_FILES=200
# 旧通道插件调用超时（秒，默认 3 = 历史行为）
PLUGIN_LEGACY_CALL_TIMEOUT=3
# 旧通道插件调用超时上限（秒）
PLUGIN_LEGACY_CALL_TIMEOUT_MAX=30

# ========== 群聊知识（Meme） ==========
# 每日梗总结任务开关
MEME_LEARNING_ENABLED=false
# 梗知识库路径（需重启）
MEME_KNOWLEDGE_DB_PATH=./data/knowledge.db  # 需重启
# 梗总结周期（小时）
MEME_SUMMARY_INTERVAL_HOURS=24
# 每群梗知识条数上限
MAX_GROUP_MEMES=500
# 每群消息缓冲上限（需重启）
MEME_BUFFER_PER_GROUP=1000  # 需重启
# 单轮总结最多处理群数
MEME_MAX_GROUPS_PER_RUN=20
# 总结最少消息数
MEME_MIN_MESSAGES_PER_SUMMARY=10
# 单群单轮候选梗上限
MEME_MAX_SUMMARY_CANDIDATES=20

# ========== 启动专用与其他配置 ==========
# Web UI 管理员初始用户名。面板中保存的管理员账号优先生效。
WEB_UI_USERNAME=admin
# Web UI 初始密码。留空时首次打开面板可注册管理员，建议通过面板设置密码。
WEB_UI_PASSWORD=
