# 开发/UI 调试用配置（不含真实密钥，可安全分发）
# 用法：cp .env.dev .env
#
# 注意：这里的 DEEPSEEK_API_KEY 是**占位符**，会被 Flowerie 识别为「未配置」，
#       搜索自动走免费引擎（ddg/bing/searxng），不会产生任何 API 费用。
#       正好可以借此验证 Web UI 里「模板值 / 未配置」两种状态的展示。

# ---------- 必填（否则无法启动）----------
DEEPSEEK_API_KEY=sk-original-replace-me
BOT_QQ=10000

# ---------- 连接 ----------
WS_PORT=3001
WEB_UI_PORT=8080
WEB_UI_PASSWORD=changeme

# ---------- 搜索（UI 调试用）----------
# 引擎顺序交由 SEARCH_DEEPSEEK_PRIORITY 自动编排：
# 无可用 DeepSeek Key → 自动剔除 deepseek-native，走免费引擎
SEARCH_DEEPSEEK_PRIORITY=true
SEARCH_PAID_ENABLED=true
SEARCH_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1
SEARCH_DEEPSEEK_MODEL=deepseek-v4-flash
SEARCH_DEEPSEEK_MAX_USES=3

# ---------- 关闭会花钱/联网的功能 ----------
AI_SEARCH_ENABLED=false
PROFILE_ENABLED=false
DIGEST_ENABLED=false
STICKER_ENABLED=false
MCP_ENABLED=false
VISION_ENABLED=false
